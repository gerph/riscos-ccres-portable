##
# CCRes - Linux/Unix Makefile
# Builds the command-line converter only (no GUI)
#
# Build the tool:
#   - `make -f Makefile.linux`
#
# Run the tests (JUnitXML report in test-results/):
#   - `make -f Makefile.linux tests`
#
# Run only the unit tests of the documentation generator:
#   - `make -f Makefile.linux tests-tools`
#
# Run the tests against an AddressSanitizer build, to find memory errors:
#   - `make -f Makefile.linux tests-asan`
#
# Regenerate the field reference in the manual, after changing the converter:
#   - `make -f Makefile.linux docs`
#
# Check that the manual's field reference is up to date:
#   - `make -f Makefile.linux docs-check`
#
# Remove generated files:
#   - `make -f Makefile.linux clean`

CC = gcc
CFLAGS = -I. -DHAVE_STRCASECMP -DHAVE_STRNCASECMP -Wall -Wno-parentheses -O2
LDFLAGS =

TARGET = ccres

# AddressSanitizer build of the tool, for tests-asan
ASAN_TARGET = ccres-asan
ASAN_CFLAGS = -I. -DHAVE_STRCASECMP -DHAVE_STRNCASECMP -Wall -Wno-parentheses -O1 -g \
              -fsanitize=address -fno-omit-frame-pointer
# Leaks are not checked: the tool frees little before it exits.
ASAN_OPTIONS_TESTS = detect_leaks=0

TEST_RUNNER = tests/run-tests.sh

# The manual, and the generator of its field reference
MANUAL = prminxml/riscos-ccres.xml
FORMAT_DOCS = tools/formatdocs.py
TEST_RESULTS = test-results

SRCS = CMD.c Convert.c Error.c Utils.c Library.c Eval.c \
       _Object.c _Window.c _Menu.c _SaveAs.c _Iconbar.c \
       _Scale.c _ColourDbox.c _ColourMenu.c _DCS.c \
       _FileInfo.c _FontDbox.c _FontMenu.c _PrintDbox.c \
       _ProgInfo.c _Quit.c _Gadgets.c _Icon.c \
       _OptionsWindow.c _UpdateCheck.c Skeleton.c

OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

$(ASAN_TARGET): $(SRCS) $(wildcard *.h)
	$(CC) $(ASAN_CFLAGS) -o $@ $(SRCS)

clean:
	rm -f $(OBJS) $(TARGET) $(ASAN_TARGET)
	rm -rf $(TEST_RESULTS)

# Reference decodes, round trips of TestQueue, skeletons, the cases in
# tests/cases, and the unit tests of the documentation generator
tests: $(TARGET) tests-tools
	bash $(TEST_RUNNER) --ccres ./$(TARGET)

tests-tools:
	python3 -P -m unittest discover -s tools -p 'test_*.py'

# Retained for those used to the earlier name
test: tests

tests-asan: $(ASAN_TARGET)
	ASAN_OPTIONS=$(ASAN_OPTIONS_TESTS) JUNITXML_SUITE=ccres-asan JUNITXML_NAME=Test-ccres-asan.xml \
		bash $(TEST_RUNNER) --ccres ./$(ASAN_TARGET)

docs: $(TARGET)
	python3 -P $(FORMAT_DOCS) --ccres ./$(TARGET) $(MANUAL)

docs-check: $(TARGET)
	python3 -P $(FORMAT_DOCS) --ccres ./$(TARGET) --check $(MANUAL)

# `make help` generates its message from the comment at the top of the file
help:
	@sed -E '/^$$/q ; /^([^#]|#[#!])/ d ; s/^#+ ?//' < $(firstword $(MAKEFILE_LIST))

.PHONY: all clean test tests tests-tools tests-asan docs docs-check help
